{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ffmpeg", "fc-match"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["*.{js,ts}", "scripts/**/*.mjs"]
    },
    "apps/api": {
      "entry": ["src/worker.ts", "src/__tests__/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/extension": {
      "entry": ["src/entrypoints/*.ts", "src/entrypoints/**/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "evals": {
      "project": ["**/*.ts"]
    }
  }
}
