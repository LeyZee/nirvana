{
  "name": "@nirvana/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/test/index.ts",
    "./testing/global-setup": "./src/test/global-setup.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "test:integration": "vitest run --config vitest.integration.config.ts --fsModuleCachePath node_modules/.vitest-cache",
    "drift": "tsx scripts/check-drift.mjs",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@nirvana/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
