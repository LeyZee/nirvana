# Copier en .env (ignoré par git). Toute variable est validée au démarrage (Zod) ; une variable manquante fait échouer le démarrage.
NODE_ENV=development
LOG_LEVEL=info

# Base de données : rôle applicatif (RLS) et rôle admin (jobs *Unscoped, migrations)
DATABASE_URL=postgres://nirvana_app:change-me@localhost:5432/nirvana
DATABASE_ADMIN_URL=postgres://nirvana_admin:change-me@localhost:5432/nirvana

# Chiffrement des sessions plateforme (AES-256-GCM). Format versionné : v2:<base64>,v1:<base64>
SESSION_ENCRYPTION_KEYS=v1:replace-with-openssl-rand-base64-32

# Auth dashboard (Better Auth)
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Extension : jeton d'appareil pour POST /connector/sessions
EXTENSION_DEVICE_TOKEN=replace-me

# Fournisseurs LLM (seuls ceux configurés dans CreatorSettings.llm sont requis)
LLM_XAI_API_KEY=
LLM_MISTRAL_API_KEY=
LLM_VENICE_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=europe-west1

# Observabilité
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Stockage objet (médias), S3-compatible
S3_ENDPOINT=
S3_BUCKET=nirvana-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web Push (PWA, phase 5)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Dev : worker dans le même processus que l'API
NIRVANA_INLINE_WORKER=1
