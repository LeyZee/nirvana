{
  "name": "@nirvana/api",
  "version": "0.0.0",
  "private": true,
  "description": "API Fastify et worker Graphile de Nirvana : même code, deux entrées (src/index.ts, src/worker.ts).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts src/worker.ts --format esm --target node22 --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "playground": "tsx --env-file-if-exists=../../.env src/scripts/playground.ts"
  },
  "dependencies": {
    "@nirvana/contracts": "workspace:*",
    "@nirvana/llm": "workspace:*",
    "fastify": "5.12.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
