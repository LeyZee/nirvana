{
  "name": "nirvana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Agent de chatting pour créatrice de contenu : connecteurs de plateformes, moteur IA supervisé, mémoire fan, dashboard.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "lefthook install || echo lefthook skipped: not a git checkout",
    "dev": "turbo run dev --parallel --filter=@nirvana/api --filter=@nirvana/web",
    "build": "turbo run build",
    "check": "turbo run typecheck lint && prettier --check . && knip && node scripts/check-repo.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:all": "pnpm test && pnpm test:integration",
    "db:generate": "pnpm --filter @nirvana/db generate",
    "db:migrate": "pnpm --filter @nirvana/db migrate",
    "db:studio": "pnpm --filter @nirvana/db studio",
    "db:rebuild-projections": "pnpm --filter @nirvana/api rebuild-projections",
    "persona:validate": "pnpm --filter @nirvana/api persona:validate",
    "persona:load": "pnpm --filter @nirvana/api persona:load",
    "ops:kill-switch": "pnpm --filter @nirvana/api ops:kill-switch",
    "ops:revoke-sessions": "pnpm --filter @nirvana/api ops:revoke-sessions",
    "ops:reencrypt-sessions": "pnpm --filter @nirvana/api ops:reencrypt-sessions",
    "evals": "pnpm --filter @nirvana/evals run run",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
