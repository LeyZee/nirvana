# Copy to .env (ignored by git). Every variable is validated at startup (Zod, apps/api/src/config.ts);
# a missing required variable fails the startup. Single file for api and worker; apps/web uses VITE_* only.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
# Commit SHA of the running image (Sentry release, worker heartbeat)
RELEASE=dev
# Requests per minute and per IP before 429
RATE_LIMIT_PER_MINUTE=300
# Jobs a worker runs at once (jobs of one conversation always stay serial)
WORKER_CONCURRENCY=5

# Database: application role (RLS applies) and admin role (*Unscoped jobs, migrations)
DATABASE_URL=postgres://nirvana_app:change-me@localhost:5432/nirvana
DATABASE_ADMIN_URL=postgres://nirvana_admin:change-me@localhost:5432/nirvana

# Platform session encryption (AES-256-GCM). Versioned list, newest first: v2:<base64>,v1:<base64>
# Required in production. In development the placeholder counts as unset: sessions cannot be stored.
SESSION_ENCRYPTION_KEYS=v1:replace-with-openssl-rand-base64-32
# AI service keys pasted in Réglages › Modèles IA (ADR 0016), same format, a different key. Required in production;
# unset in development, pasted keys stay in memory until restart.
CREDENTIALS_ENCRYPTION_KEYS=v1:replace-with-openssl-rand-base64-32

# Dashboard auth (Better Auth)
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public URL of the API as the browser sees it: in development the dashboard proxies /v1 to the API
AUTH_BASE_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Extension device token for POST /v1/connector/sessions. Dev bootstrap value only:
# from phase 2 the tokens live hashed in the database and are issued/revoked from the dashboard.
# Required in production (32+ characters). In development the placeholder counts as unset: the route refuses.
EXTENSION_DEVICE_TOKEN=replace-me

# AI service keys, development only: in production they are pasted in the dashboard (ADR 0016) and these are ignored.
LLM_XAI_API_KEY=
# Mistral, the writing fallback when Grok does not answer: pasted in Réglages > Modèles IA > Services.
LLM_MISTRAL_API_KEY=
# Venice: no role uses it by default and no screen sets it yet; read here for a role pointed at it by hand.
LLM_VENICE_API_KEY=
# Gemini API (Google AI Studio): the Vision role, photos and videos (Charles, 17/10)
LLM_GOOGLE_API_KEY=
# Voice notes (ElevenLabs)
SPEECH_ELEVENLABS_API_KEY=

# Entraîner > Playground: persona to train on, from the repository root or absolute (the real one lives outside
# the repository; demo persona when empty)
PLAYGROUND_PERSONA_PATH=
# Playground ratings, outside the repository (.scratch/training when empty)
NIRVANA_TRAINING_DIR=

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted behind Cloudflare Access (operations.md, threat-model.md): traces contain intimate content,
# never send them to Langfuse Cloud.
LANGFUSE_BASE_URL=http://localhost:3001

# Object storage (media), S3-compatible
S3_ENDPOINT=
S3_BUCKET=nirvana-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web Push (PWA, phase 5)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Dev: run the worker inside the API process
NIRVANA_INLINE_WORKER=1
