{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js", ".prettierrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/personas/**", "$TURBO_ROOT$/evals/**"],
      "outputs": []
    },
    "test:integration": {
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["NIRVANA_TEST_PG_URL", "DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
