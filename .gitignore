# Dépendances et builds
node_modules/
dist/
.output/
.wxt/
.turbo/
coverage/
*.tsbuildinfo

# Temporaire (politique d'hygiène) : tout fichier de travail va ici
.scratch/*
!.scratch/.gitkeep

# Secrets et environnement
.env
.env.*
!.env.example

# Données réelles : jamais dans le dépôt (les enregistrements FakeReveal anonymisés, eux, sont suivis)
personas/**/v[1-9]*.yaml
*.har
*.sql.gz
*.age

# Outils
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
# Copies de travail temporaires des agents (Claude Code)
.claude/worktrees/
