{
  "name": "@nirvana/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Design system Nirvana (verre liquide, néon rouge) : tokens, pont Tailwind v4, classes de composants, aides d'animation. Consommé par apps/web et apps/extension.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./base.css": "./src/styles/base.css",
    "./components.css": "./src/styles/components.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/playfair-display": "5.3.0"
  }
}
